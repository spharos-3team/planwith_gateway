# Copy to .env for local (non-Docker) runs. .env is gitignored.
# Do not put production LAN IPs into application.yaml defaults.

SERVER_PORT=8000
SERVER_ADDRESS=0.0.0.0

# 로컬 단독: Eureka 끄고 이 PC Member로 직접 라우팅
EUREKA_CLIENT_ENABLED=false
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
EUREKA_PREFER_IP_ADDRESS=true
MEMBER_SERVICE_URI=http://127.0.0.1:8082
MEETING_SERVICE_URI=http://127.0.0.1:8086

# JWT validation (must match Member Service app.jwt / JWT claims)
# iss claim value from Member (often still http://localhost:8082 even in Docker)
JWT_ISSUER=http://localhost:8082
JWT_AUDIENCE=planwith-api
# Local: 127.0.0.1 avoids Windows localhost → IPv6 hang. Docker Compose overrides to planwith-fo-member.
# Hybrid local gateway (profile=local): see application-local.yaml
JWT_JWK_SET_URI=http://127.0.0.1:8082/oauth2/jwks
