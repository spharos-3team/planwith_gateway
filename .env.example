# Required for Backend trust
GATEWAY_INTERNAL_TOKEN=local-gateway-internal-token

# JWT validation (fo-user-be JWKS)
JWT_JWK_SET_URI=http://localhost:8080/oauth2/jwks
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=planwith-api

# Eureka
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
EUREKA_PREFER_IP_ADDRESS=true
EUREKA_INSTANCE_ID=

# Gateway
SERVER_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
