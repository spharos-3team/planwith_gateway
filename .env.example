# Copy to .env for local (non-Docker) runs. .env is gitignored.
# Do not put production LAN IPs into application.yaml defaults.

SERVER_PORT=8000
SERVER_ADDRESS=0.0.0.0

# Local Eureka. In Docker, compose sets http://discovery:8761/eureka/
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
EUREKA_PREFER_IP_ADDRESS=true

# JWT validation (must match Member Service app.jwt / JWT claims)
# iss claim value from Member (often still http://localhost:8082 even in Docker)
JWT_ISSUER=http://localhost:8082
JWT_AUDIENCE=planwith-api
# Default (no local profile): local Member JWKS. Docker Compose uses http://planwith-fo-member:8082/oauth2/jwks
# Hybrid local gateway (profile=local): see application-local.yaml (remote member JWKS + upstream)
JWT_JWK_SET_URI=http://localhost:8082/oauth2/jwks
