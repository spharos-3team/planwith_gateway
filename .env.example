# Copy to .env for local (non-Docker) runs. .env is gitignored.
# Do not put production LAN IPs into application.yaml defaults.

SERVER_PORT=8000
SERVER_ADDRESS=0.0.0.0

# Local Eureka. In Docker, compose sets http://discovery:8761/eureka/
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
EUREKA_PREFER_IP_ADDRESS=true
